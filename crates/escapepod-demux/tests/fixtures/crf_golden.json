 "recursions": {
  "layout": "Ms = scores.reshape(T, N, 256, 5); c = DESTINATION state, k = dropped base (0 = stay/blank). Confirmed against bonito's own comment in CTC_CRF.compute_transition_probs: '(new_state, dropped_base)'.",
  "alpha": "alpha[0][s] = S.one (0.0); alpha[t+1][c] = S.sum_k( alpha[t][idx[c,k]] + Ms[t,n,c,k] )",
  "beta": "beta[T][s] = S.one (0.0); beta[t][s] = S.sum over the 5 edges (c,k) with idx[c,k]==s of ( Ms[t,n,c,k] + beta[t+1][c] )",
  "posteriors_Log": "softmax over the flattened 1280 (c,k) of ( alpha[t][idx[c,k]] + Ms[t,n,c,k] + beta[t+1][c] ); sums to 1 over dim 2 -- it is a probability, not a log-probability, despite the name (it is the autograd gradient of logZ).",
  "posteriors_Max": "one-hot 1.0 at argmax over the flattened 1280 of the same expression, using the Max semiring alphas/betas.",
  "traceback_argmax": "argmax over dim 2 of posteriors(s2, Max) == argmax of ( alpha_max[t][idx[c,k]] + s2[t,n,c,k] + beta_max[t+1][c] )",
  "viterbi": "tb = traceback_argmax; move = (tb % 5) != 0; path = move ? 1 + ((tb // 5) % 4) : 0  (tb//5 = destination state c, its low 2 bits are the newly emitted base)",
  "path_to_str": "concat alphabet[p] for p != 0, alphabet = NACGT",
  "S.one": 0.0,
  "S.zero": -1e+38,
